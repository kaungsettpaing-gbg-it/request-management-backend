generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  name       String?
  department String?
  role       String     @default("USER")
  telegramId String?
  otp        String?
  otpExpiry  DateTime?
  requests   Request[]
  auditLogs  AuditLog[]
}

model Request {
  id               Int        @id @default(autoincrement())
  title            String
  description      String?
  category         String     @default("General")
  status           String     @default("PENDING") // PENDING, APPROVED, REJECTED
  targetDepartment String?    @default("General") // Cross-Department Request Target
  approvalStage    String?    @default("DEPT_MGR") // DEPT_MGR -> DGM -> GM -> COMPLETED
  extraFields      String?
  attachment       String?
  userId           Int
  user             User       @relation(fields: [userId], references: [id])
  auditLogs        AuditLog[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String // e.g., "APPROVED", "REJECTED", "SUBMITTED"
  remarks   String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  requestId Int
  request   Request  @relation(fields: [requestId], references: [id])
  createdAt DateTime @default(now())
}
