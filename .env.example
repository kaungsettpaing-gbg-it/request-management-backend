# PostgreSQL connection URL for local development and production.
# Configure the token in the local .env file or Railway's encrypted variables. Never commit it.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="telegbg_bot"
# Optional: defaults to a value derived from JWT_SECRET.
TELEGRAM_WEBHOOK_SECRET=""
# Optional: Railway uses RAILWAY_PUBLIC_DOMAIN to build this URL automatically.
TELEGRAM_WEBHOOK_URL=""
# Numeric private chat ID for centralized alerts; alternatively link Telegram to the SUPER_ADMIN account.
SUPER_ADMIN_TELEGRAM_CHAT_ID=""
SUPER_ADMIN_EMAIL="superadmin@company.com"
SUPER_ADMIN_TELEGRAM_USERNAME="okeydokey2"
# Set these only for a one-time `npm run superadmin:reset-password` operation, then unset them.
SUPER_ADMIN_RESET_CONFIRM_EMAIL=""
SUPER_ADMIN_RESET_PASSWORD=""
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
